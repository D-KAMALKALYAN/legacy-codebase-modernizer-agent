# Server Configuration
PORT=8000
ENVIRONMENT=development

# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# CURRENT: Using local Ollama for FREE testing
# TO SWITCH TO OPENAI: Change to "openai" and add API key below
# ============================================================
LLM_PROVIDER=ollama

# ============================================================
# OLLAMA (Local LLM) - ACTIVE FOR TESTING
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ============================================================
# OPENAI (Cloud API) - FOR PRODUCTION
# ============================================================
# Uncomment and add your API key when ready for production:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
# ANTHROPIC (Alternative Cloud API)
# ============================================================
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-20250514

# Redis Configuration Or for Upstash: redis://default:password@xxxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
CACHE_TTL_SNIPPET=2592000
CACHE_TTL_FOLDER=604800
CACHE_TTL_ZIP=1209600

# Processing Configuration
MAX_TOKENS_PER_REQUEST=8000
CHUNK_SIZE=3000
MAX_FILES_PER_ANALYSIS=100

# Backend Service
BACKEND_URL=http://localhost:5000

# Logging
LOG_LEVEL=INFO