# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/legacy-modernizer

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# File Upload Limits
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.js,.ts,.py,.java,.go,.rb,.php,.cs

# CORS
FRONTEND_URL=http://localhost:3000